#pragma kernel CSMain

RWTexture2D<float4> LookupTexture;

float3 plateColours[25];

[numthreads(8,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    //texture will be x = n, y = 1
    //each pixel needs to store a colour based on the index in the plateColours array



    LookupTexture[id.xy] = float4(id.x & id.y, (id.x & 15)/15.0, (id.y & 15)/15.0, 0.0);
}
